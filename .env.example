# ========================================
# PIA — Environment Variables
# ========================================
# Copy this file to .env and fill in values

# Google Gemini API Key (required — used for grounded features + LLM fallback)
# Get from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Groq API Key (recommended — primary provider for non-grounded text/extraction)
# Separate quota from Google, much higher free-tier RPD. If unset, the app
# falls back to Gemini automatically. Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# MongoDB (optional — set USE_MONGODB=true to enable)
# For MongoDB Atlas use a mongodb+srv:// URI (requires pymongo[srv]).
# Falls back to the JSON store automatically if the cluster is unreachable.
USE_MONGODB=false
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=pia_db
MONGODB_VECTOR_COLLECTION=vector_chunks

# Structured data fallback (when USE_MONGODB=false)
JSON_STORE_DIR=./json_data

# Redis cache (optional — leave unset to run without caching).
# When set (Render Key Value / Upstash), caches grounded dossiers + Top Asked
# for CACHE_TTL_HOURS (± jitter) and backs the JWT refresh-token store.
# Absent Redis degrades to a no-op — the app works unchanged.
REDIS_URL=
CACHE_TTL_HOURS=24

# Auth / JWT
# JWT_SECRET must be a long random string in production (e.g. `openssl rand -hex 32`).
# If unset, the app falls back to an insecure dev secret and logs a warning.
# Refresh-token revocation uses Redis (REDIS_URL above); without it, refresh
# tokens work but can't be server-side revoked on logout.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Model Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Non-grounded answer generation (Ask Puddy). Gemini is the FALLBACK here — Groq
# is tried first (see backend/rag/llm_client.py). Lite = 500 RPD vs 2.5-flash 20 RPD.
LLM_MODEL=gemini-3.5-flash-lite
# Fast model for structured extraction (resume analyzer, ingestion)
LLM_EXTRACTION_MODEL=gemini-3.5-flash-lite
# Groq model for non-grounded text (primary). Production-tier, not deprecated.
GROQ_MODEL=openai/gpt-oss-20b
# Grounded company research (About the Company, Top Asked). Google Search grounding
# draws from a SEPARATE ~1.5K RPD tool quota, so a lite model works here too.
LLM_GROUNDING_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.2

# Retrieval Configuration
DENSE_WEIGHT=0.5
BM25_WEIGHT=0.5
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5

# Chunking Configuration
CHUNK_SIZE_INTERVIEW=512
CHUNK_OVERLAP_INTERVIEW=64
CHUNK_SIZE_JD=768
CHUNK_OVERLAP_JD=128
CHUNK_SIZE_APTITUDE=1024
CHUNK_OVERLAP_APTITUDE=128

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
